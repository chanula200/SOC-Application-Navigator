@model List<ApplicationNavigator.Models.NavigationItem>

@{
    ViewData["Title"] = "Application Navigator";
    var initials = User.FindFirst("given_name")?.Value?.FirstOrDefault() ?? 'U';
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"]</title>
    <link rel="stylesheet" href="/css/style.css?v=20260812-2">
</head>
<body>
    <header class="navbar">
        <a class="brand" href="@Url.Action("Index", "Home")" aria-label="SLT Mobitel Application Navigator home">
            <img class="slt-logo" src="/slt-logo.svg?v=20260812-2" alt="SLT Mobitel">
            <span class="navbar-divider" aria-hidden="true"></span>
            <span class="navbar-label">
                <span class="overline">Service Operation Center</span>
                <span class="title">Application Navigator</span>
            </span>
        </a>

        <div class="user-profile">
            <span class="user-avatar" aria-hidden="true">@initials</span>
            <span class="user-info">
                <span class="user-name">@(User.FindFirst("name")?.Value ?? "User")</span>
                <span class="user-email">@(User.FindFirst("preferred_username")?.Value ?? "user@example.com")</span>
            </span>
            <form method="post" action="@Url.Action("Logout", "Account")">
                <button type="submit" class="logout-btn">Sign out</button>
            </form>
        </div>
    </header>

    <main class="container">
        <section class="header-section" aria-labelledby="page-title">
            <p class="soc-label">Service Operation Center</p>
            <h1 id="page-title">Choose a <span>system</span> to continue</h1>
            <p class="subtitle">Your central access point for operational systems, monitoring tools, and service management.</p>
        </section>

        <section class="cards-grid" aria-label="Available systems">
            @foreach (var item in Model ?? new List<ApplicationNavigator.Models.NavigationItem>())
            {
                <article class="service-card" data-name="@item.Name" data-url="@item.Url" tabindex="0">
                    <div class="card-icon" aria-hidden="true">
                        <span>@item.Name.FirstOrDefault()</span>
                    </div>
                    <div class="card-content">
                        <h2 class="card-title">@item.Name</h2>
                        <p class="card-description">@item.Description</p>
                    </div>
                    <button class="nav-button" type="button" aria-label="Open @item.Name">
                        Open system <span aria-hidden="true">&rarr;</span>
                    </button>
                </article>
            }
        </section>
    </main>

    <div id="status-message" class="status-message" role="status" aria-live="polite"></div>
    <footer class="footer">&copy; @DateTime.Now.Year SLT-MOBITEL &middot; Service Operation Center</footer>
    <script src="/js/app.js?v=20260812-2"></script>
</body>
</html>
